#
# aviengine's configuration 
#

postgis:
{
	# Enter Your postgres database connection data below

	host		= "localhost";
	port		= 5432;
	database	= "avi";
	username	= "avi_user";
	password	= "avi_pw";
	encoding	= "UTF8";

	startconnections = 5;  # Start size of database connection pool
	maxconnections = 10;   # Max size of database connection pool

	# Detection of dead connections, e.g. pooled connections silently dropped (no FIN/RST) by a
	# firewall/NAT on the network path while idle. All default to 0 (disabled).
	# They can also be set for some hosts only, see 'overrides' at the end of the file.
	#
	# connecttimeout = 10;       # s; max time to wait for a (re)connect (libpq connect_timeout);
	#                            # without it a connect to an unreachable server is unbounded
	# tcpusertimeout = 20000;    # ms; max time sent data (e.g. a query) may stay unacknowledged
	#                            # before the connection is aborted (libpq tcp_user_timeout).
	#                            # Without it the kernel retransmits for ~15-20 minutes
	# keepalivesidle = 60;       # s; inactivity before the first TCP keepalive probe
	# keepalivesinterval = 10;   # s; interval between unacknowledged keepalive probes
	# keepalivescount = 3;       # unacknowledged probes before the connection is considered dead
	# maxidletime = 300;         # s; pooled connections idle longer than this are closed and
	#                            # reopened before use. Set below the idle timeout of the
	#                            # firewall/NAT on the network path
};

message:
{
							# Note: 'maxstations' and 'maxrows' limits can be overridden (with values >= 0) when querying data
							#
	maxstations	 = 0;		# max number of stations allowed in message query; if missing or <= 0, unlimited; if exceeded, an error is thrown
	maxrows		 = 0;		# max number of messages fetched; if missing or <= 0, unlimited; if exceeded, an error is thrown

										# offsets expanding the message_time range to include messages that can be valid at/within
										# the time instant/range requested
										#
	recordsetstarttimeoffsethours = 30;	# include messages upto message_time n hours backwards from observation time / time range start time
	recordsetendtimeoffsethours = 12;	# include messages upto message_time n hours forwards from observation time / time range end time

	# In-memory message cache (DuckDB mirror of recent avidb_* rows).
	#
	# When enabled, a background thread copies the last durationhours of avidb_messages and the
	# station, message type, format and route tables into an in-process DuckDB database, and
	# refreshes it every updateintervalsec. Requests for the latest valid TAC or IWXXM messages at
	# the current time are then answered from the mirror instead of PostgreSQL. Everything else
	# (time ranges, explicit times, rejected messages, routes, longitude/latitude/lonlat/latlon/
	# distance/bearing columns) uses PostgreSQL, and so does any query the mirror fails to run,
	# so the cache is a pure optimization. Station lookups always use PostgreSQL.
	#
	# When disabled (the default), no DuckDB database is created and all requests use PostgreSQL.

	cache:
	{
		enabled           = false;	# master switch; opt-in
		durationhours     = 48;		# hours of avidb_messages kept in the mirror; must be > recordsetstarttimeoffsethours
		updateintervalsec = 10;		# background refresh interval in seconds
		safetymarginsec   = 600;	# re-read window (seconds) for late-arriving / updated rows
		shadowcompare     = false;	# rollout aid: run both PostgreSQL and cache, log differences, return the PostgreSQL result
		# memorylimitmb   = 0;		# optional DuckDB memory limit in MB; 0 = DuckDB default (80% of RAM)
	};

	# Filtering of finnish METARs; if enabled, by default returning finnish METARs only when they are LIKE "METAR%".
	# Stations can be excluded from filtering by their icao code

	filter_FI_METARxxx =
	{
		filter = true;
		excludeicaos = ["EFHF","EFUT"];
	};

	types =
	(
		#
		# Message type names:
		#
		#	If multiple names are given, latest message for the group is returned.
		#
		#	name = "type";
		#	names = [ "type1", "type2", ... ];
		#
		# Query time range selection:
		#
		# 	timerangetype = "validtime"; 		using valid_from and valid_to columns
		# 	timerangetype = "messagevalidtime";	using message_time and valid_to column, or if valid_from and valid_to are NULLs,
		#										message_time column and range length (hours forwards) if given with 'validityhours' setting
		# 	timerangetype = "messagetime";		using message_time column and range length (hours forwards) given with 'validityhours' setting
		# 	timerangetype = "creationtime";		using creation_time and valid_to columns
		#
		# Query latest or all valid messages:
		#
		#	latestmessage = true;			return the latest message for each type or group
		#	latestmessage = false;			return all valid messages
		#
		#									Note: when timerangetype=messagetime and latestmessage=true, querying the latest valid
		#										  (i.e. when [message_time,message_time+validityhours] range overlaps the given time range)
		#										  message having message_time earlier than range starttime in addition to all messages
		#										  having starttime <= message_time < endtime
		#
		# Additional message grouping with messir_heading LIKE patterns when querying latest messages:
		#
		#	messirpatterns = [ "pattern1", "pattern2", ... ];
		#
		# Message scope (default "station"):
		#
		#	scope = "station";				messages are bound to stations
		#	scope = "fir";					messages are bound to FIR areas
		#	scope = "global";				messages are not bound to any location
		#
		# Delaying the latest message during publication (timerangetype = "messagevalidtime" and
		# latestmessage = true only); e.g. TAFs are stored every 3rd hour between xx:20 and xx:40,
		# and during those hours the output of the latest message is delayed until the end minute:
		#
		#	queryrestrictionhours = [ hour1, hour2, ... ];
		#	queryrestrictionicaopatterns = [ "pattern1", ... ];	stations restricted by icao LIKE pattern(s) and/or
		#	queryrestrictioncountrycodes = [ "code1", ... ];		by country code(s); at least one of them is required
		#	queryrestrictionstartminute = minute;				both minutes (0-59) are required,
		#	queryrestrictionendminute = minute;				end minute > start minute
		#
		{
			names = [ "METAR","SPECI" ];
			timerangetype = "messagetime";
			validityhours = 2;
			latestmessage = true;
		},
		{
			name = "AWSMETAR";
			timerangetype = "messagetime";
			validityhours = 2;
			latestmessage = true;
		},
		{
			name = "TAF";
			timerangetype = "messagevalidtime";
			validityhours = 4;					# 'NIL' messages have no valid from/to; use message_time - message_time+'validityhours' time range
			latestmessage = true;
                        queryrestrictionhours = [ 2,5,8,11,14,17,20,23 ];
                        queryrestrictioncountrycodes = [ "FI" ];
                        queryrestrictionstartminute = 20;
                        queryrestrictionendminute = 40;
		},
		{
			names = [ "METREP","SPECIAL" ];
			timerangetype = "validtime";
			latestmessage = true;
		},
		{
			name = "ARS";
			timerangetype = "messagetime";
			validityhours = 2;
			latestmessage = false;
		},
		{
			name = "WXREP";
			timerangetype = "messagetime";
			validityhours = 2;
			latestmessage = false;
		},
		{
			name = "WRNG";
			timerangetype = "messagetime";
			validityhours = 2;
			latestmessage = false;
		},
		{
			name = "SIGMET";
			timerangetype = "creationtime";
			latestmessage = false;
		},
		{
			name = "GAFOR";
			timerangetype = "creationtime";
			latestmessage = true;
			messirpatterns = [ "FBFI41%","FBFI42%","FBFI43%" ];
		},
		{
			name = "LOWWIND";
			timerangetype = "messagetime";
			validityhours = 4;
			latestmessage = true;
		}
	);

	# When querying rejected messages for given time range, selecting messages where
	#
	#	(message.created >= start time AND message.created < end time)
	#
}

# Host specific values for the dead connection detection and idle connection recycling settings
# of the postgis section (connecttimeout, tcpusertimeout, keepalives*, maxidletime). An entry
# applies when one of its names is a prefix of the host name (case insensitive); the first
# matching entry with a value for the setting wins, otherwise the postgis section value (or 0)
# applies. Other settings are not read from here.
#
# overrides:
# (
# 	{
# 		name = ["backend1", "backend2"];
# 		postgis:
# 		{
# 			connecttimeout = 10;
# 			tcpusertimeout = 20000;
# 			keepalivesidle = 60;
# 			keepalivesinterval = 10;
# 			keepalivescount = 3;
# 			maxidletime = 300;
# 		};
# 	}
# );
